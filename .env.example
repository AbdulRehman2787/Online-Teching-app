# Application Settings
APP_NAME="Online Teaching & Learning Platform"
APP_ENV="development"
PORT=8000
SECRET_KEY="super-secret-key-change-this-in-production-min-32-chars-long"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (MySQL)
# Default MySQL connection:
DATABASE_URL="mysql+pymysql://root:password@localhost:3306/online_teaching_db"
# Fallback to SQLite if MySQL is not available or during local quick test
FALLBACK_TO_SQLITE=True
SQLITE_URL="sqlite:///./online_teaching.db"

# LiveKit Open Source WebRTC Server Configuration
# For local testing, you can run LiveKit server or use LiveKit Cloud free tier
LIVEKIT_URL="ws://localhost:7880"
LIVEKIT_API_KEY="devkey"
LIVEKIT_API_SECRET="secret"

# Upload Directory
UPLOAD_DIR="./uploads/books"
MAX_UPLOAD_SIZE_MB=50

# Permanent Classroom Defaults
PERMANENT_CLASS_ID="CLASS-PERMANENT-01"
DEFAULT_CLASS_NAME="Master Live Classroom"
DEFAULT_CLASS_PASSWORD="Learn123"
MAX_STUDENTS_LIMIT=20
